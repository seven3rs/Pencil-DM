{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pencil Download Manager",
  "mainBinaryName": "pencil-download-manager",
  "version": "0.1.0",
  "identifier": "strs.pencil.downloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Pencil Download Manager",
        "width": 1000,
        "height": 640,
        "minWidth": 720,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pencil"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFERkIyM0RBOTI4QUJCRjgKUldUNHU0cVMyaVA3cllEejRmbytZMG94OGRJY25waXlvcnZySDZ6T3hWRmhWVHRNNnF6OWJWZisK",
      "endpoints": [
        "https://github.com/seven3rs/Pencil-Download-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Fast, simple download manager",
    "longDescription": "Pencil Download Manager accelerates and organizes your downloads.",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../extension/manifest.json": "extension/manifest.json",
      "../extension/manifest.firefox.json": "extension/manifest.firefox.json",
      "../extension/background.js": "extension/background.js",
      "../extension/popup.html": "extension/popup.html",
      "../extension/popup.css": "extension/popup.css",
      "../extension/popup.js": "extension/popup.js",
      "../extension/icon.png": "extension/icon.png",
      "../extension/PRIVACY.md": "extension/PRIVACY.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./windows/sign-windows.ps1 %1"
    },
    "linux": {
      "deb": {
        "depends": [
          "aria2"
        ]
      },
      "rpm": {
        "depends": [
          "aria2"
        ]
      }
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
