{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pencil Download Manager",
  "mainBinaryName": "pencil-download-manager",
  "version": "0.1.0",
  "identifier": "strs.pencil.downloadmanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pencil Download Manager",
        "width": 1000,
        "height": 640,
        "minWidth": 720,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast, simple download manager",
    "longDescription": "Pencil Download Manager accelerates and organizes your downloads.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": { "depends": ["aria2"] },
      "rpm": { "depends": ["aria2"] }
    }
  }
}
